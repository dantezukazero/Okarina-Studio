{
  "name": "okarina-studio",
  "version": "1.3.0",
  "private": true,
  "description": "Zelda-Okarina-Trainer mit zusätzlichen Final-Fantasy- und Kingdom-Hearts-Sammlungen",
  "author": "Jason",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/smoke.cjs && node scripts/integration.cjs && node scripts/update-smoke.cjs && node scripts/language-smoke.cjs && node scripts/catalog-smoke.cjs",
    "library:prepare": "node scripts/prepare-library.cjs",
    "release:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "library:publish": "node scripts/catalog-publish.cjs",
    "library:bundle": "node scripts/catalog-publish.cjs --bundle",
    "library:import": "node scripts/catalog-import.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28"
  },
  "build": {
    "appId": "de.jason.okarina-studio",
    "productName": "Okarina Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "ui/**/*",
      "package.json",
      "icon.ico",
      "catalog-updater.cjs"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": true,
      "icon": "icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Okarina-Studio.exe"
    }
  }
}
